# .env defaults — copy to project root as .env

# LM Studio (local, default)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=codellama-7b-instruct
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.7

# Remote fallback (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Docker sandbox
DOCKER_SANDBOX_IMAGE=orchestra-sandbox
DOCKER_TIMEOUT=60

# Git
GIT_AUTHOR_NAME=Orchestra AI
GIT_AUTHOR_EMAIL=orchestra@local

# App
DEBUG=true
